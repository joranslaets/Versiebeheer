{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Blackjack Web Server",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/myfirstrep/web/run-web-server.ps1\"",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Open Blackjack in Browser",
      "type": "shell",
      "command": "cmd /c start http://localhost:5500",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "Launch Blackjack Web App",
      "dependsOn": ["Start Blackjack Web Server", "Open Blackjack in Browser"],
      "problemMatcher": []
    }
  ]
}
